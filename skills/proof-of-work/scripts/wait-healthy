#!/usr/bin/env bash
# Block until a Lightdash instance answers healthy; exit 1 on timeout.
set -euo pipefail
url="${1:?usage: wait-healthy <base-url> [timeout-seconds]}"
timeout="${2:-600}"
deadline=$((SECONDS + timeout))
until curl -fsS -m 10 "${url%/}/api/v1/health" 2>/dev/null | grep -q '"healthy":true'; do
  if ((SECONDS >= deadline)); then
    echo "timeout: ${url} not healthy after ${timeout}s" >&2
    exit 1
  fi
  sleep 10
done
echo "healthy: ${url}"
